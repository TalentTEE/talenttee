{
  "files.watcherExclude": {
    "**/.next/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/target/**": true,
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.planning/**": true,
    "**/.superpowers/**": true,
    "**/.artifacts/**": true,
    "**/.bg-shell/**": true,
    "**/archive/**": true,
    "**/coverage/**": true,
    "**/build/**": true,
    "**/.cargo/**": true
  },
  "search.exclude": {
    "**/.next/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/target/**": true,
    "**/.git/objects/**": true,
    "**/.planning/**": true,
    "**/archive/**": true,
    "**/coverage/**": true
  },
  "files.exclude": {
    "**/.next": true,
    "**/dist": true,
    "**/target": true,
    "**/node_modules": true,
    "**/.artifacts": true,
    "**/.bg-shell": true,
    "**/archive": true
  },
  "typescript.tsserver.maxTsServerMemory": 1536,
  "typescript.disableAutomaticTypeAcquisition": true,
  "typescript.tsserver.experimental.enableProjectDiagnostics": false,
  "git.autorefresh": false,
  "git.autofetch": false,
  "git.decorations.enabled": true,
  "git.scanRepositories": [],
  "git.repositoryScanMaxDepth": 1,
  "scm.diffDecorations": "none",
  "rust-analyzer.enable": false,
  "extensions.autoUpdate": false
}
