{
  "files.watcherExclude": {
    "**/.next/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/target/**": true,
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.planning/**": true,
    "**/.superpowers/**": true,
    "**/.artifacts/**": true,
    "**/.bg-shell/**": true,
    "**/archive/**": true,
    "**/coverage/**": true,
    "**/build/**": true
  },
  "search.exclude": {
    "**/.next/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/target/**": true,
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.planning/**": true,
    "**/.superpowers/**": true,
    "**/.artifacts/**": true,
    "**/.bg-shell/**": true,
    "**/archive/**": true,
    "**/coverage/**": true,
    "**/build/**": true
  },
  "files.exclude": {
    "**/.next": true,
    "**/dist": true,
    "**/target": true,
    "**/node_modules": true,
    "**/.artifacts": true,
    "**/.bg-shell": true,
    "**/archive": true
  },
  "typescript.tsserver.maxTsServerMemory": 4096,
  "typescript.tsserver.watchOptions": {
    "watchFile": "useFsEvents",
    "watchDirectory": "useFsEvents",
    "fallbackPolling": "dynamicPriority"
  },
  "typescript.disableAutomaticTypeAcquisition": true,
  "git.autorefresh": false,
  "git.autofetch": false,
  "git.decorations.enabled": true,
  "git.untrackedChanges": "separate",
  "git.scanRepositories": [],
  "git.repositoryScanMaxDepth": 1,
  "scm.diffDecorations": "gutter"
}
